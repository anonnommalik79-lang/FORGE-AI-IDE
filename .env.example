# ==============================================================
# FORGE / MalikLLM75B — local Mistral-backed gateway
# Copy this file to .env and paste your real Mistral key locally.
# .env is gitignored and must never be committed.
# ==============================================================

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

MISTRAL_MODEL_PRIMARY=mistral-medium-latest
MISTRAL_MODEL_FALLBACK=mistral-large-latest
MISTRAL_MODEL_CODE=devstral-latest

# User-facing identity. FORGE exposes only this model name in the IDE.
FORGE_MODEL_ALIAS=MalikLLM75B

# Local FORGE gateway used by FORGE Agent.
FORGE_GATEWAY_HOST=127.0.0.1
FORGE_GATEWAY_PORT=43175

# Reliability / efficiency
FORGE_REQUEST_TIMEOUT_MS=120000
FORGE_MAX_BODY_BYTES=12582912
FORGE_AGENT_POLICY_ENABLED=true
