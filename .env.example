# ==============================================================
# FORGE / MalikLLM75B — local multi-provider AI gateway
# Copy this file to .env and add only the providers you want to use.
# .env is gitignored and MUST never be committed.
# ==============================================================

# User-facing identity. FORGE exposes only this model name in the IDE.
FORGE_MODEL_ALIAS=MalikLLM75B

# Provider priority. Unconfigured/unhealthy providers are skipped automatically.
FORGE_PROVIDER_ORDER=omniroute,mistral,cerebras,groq,gemini
FORGE_FAILOVER_ENABLED=true
FORGE_MAX_RETRIES=2
FORGE_PROVIDER_COOLDOWN_MS=60000
FORGE_REQUEST_TIMEOUT_MS=120000
FORGE_MAX_BODY_BYTES=12582912
FORGE_AGENT_POLICY_ENABLED=true

# Local FORGE gateway used by FORGE Agent.
FORGE_GATEWAY_HOST=127.0.0.1
FORGE_GATEWAY_PORT=43175

# FORGE starts the local OmniRoute service automatically when it is the configured primary route.
# The bootstrap uses the installed global package first and falls back to npx @latest if needed.
FORGE_AUTOSTART_OMNIROUTE=true
FORGE_OMNIROUTE_START_TIMEOUT_MS=90000

# --------------------------------------------------------------
# OmniRoute (OpenAI-compatible local gateway)
# API key can be blank when your local OmniRoute instance does not require one.
# --------------------------------------------------------------
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL_PRIMARY=auto/coding:free
OMNIROUTE_MODEL_FALLBACK=
OMNIROUTE_MODEL_CODE=auto/coding:free

# --------------------------------------------------------------
# Mistral
# --------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL_PRIMARY=mistral-medium-latest
MISTRAL_MODEL_FALLBACK=mistral-large-latest
MISTRAL_MODEL_CODE=devstral-latest

# --------------------------------------------------------------
# Cerebras (OpenAI-compatible)
# --------------------------------------------------------------
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL_PRIMARY=gpt-oss-120b
CEREBRAS_MODEL_FALLBACK=
CEREBRAS_MODEL_CODE=gpt-oss-120b

# --------------------------------------------------------------
# Groq (OpenAI-compatible)
# --------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=
GROQ_MODEL_CODE=openai/gpt-oss-120b

# --------------------------------------------------------------
# Gemini OpenAI compatibility endpoint
# --------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL_PRIMARY=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=
GEMINI_MODEL_CODE=gemini-3.5-flash
